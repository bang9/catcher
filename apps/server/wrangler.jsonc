// catcher relay — Cloudflare Worker + D1. Deploy by hand: `pnpm --filter @catcher/server exec wrangler deploy`
{
  "name": "catcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "catcher.bang9.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catcher",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // realtime hub — one per owner, hibernating WebSockets carry "something new" signals only (SQLite class: free plan)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // pairing-code redemption per caller IP — 10 tries a minute
  "ratelimits": [{ "name": "REGISTER_LIMIT", "namespace_id": "6001", "simple": { "limit": 10, "period": 60 } }],
  // hourly: drop expired envelopes (30 days) and pairing codes
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "ENVELOPE_TTL_DAYS": "30" },
}
