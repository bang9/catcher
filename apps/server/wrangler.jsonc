// catcher relay — Cloudflare Worker + D1. Deploy by hand: `pnpm --filter @catcher/server exec wrangler deploy`
{
  "name": "catcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "catcher.bang9.dev", "custom_domain": true }],
  // the website (/, /docs/, /agent.md, /install.sh, /r, /.well-known/*) — static files; the relay API always runs the Worker
  "assets": {
    "directory": "public",
    "run_worker_first": ["/v1/*"],
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catcher",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // realtime hub — one per owner, hibernating WebSockets carry "something new" signals only (SQLite class: free plan)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // pairing-code redemption per caller IP — 10 tries a minute
  // owner creation per IP 5/min, sending per caller 120/min
  "ratelimits": [
    { "name": "REGISTER_LIMIT", "namespace_id": "6001", "simple": { "limit": 10, "period": 60 } },
    { "name": "OWNER_LIMIT", "namespace_id": "6002", "simple": { "limit": 5, "period": 60 } },
    { "name": "SEND_LIMIT", "namespace_id": "6003", "simple": { "limit": 120, "period": 60 } },
  ],
  // hourly: drop expired envelopes (30 days) and pairing codes
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "ENVELOPE_TTL_DAYS": "30" },
}
