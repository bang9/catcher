// catcher relay — Cloudflare Worker + D1. Deploy by hand: `pnpm --filter @catcher/server exec wrangler deploy`
{
  "name": "catcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "catcher.bang9.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catcher",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // realtime hub — one per owner, hibernating WebSockets carry "something new" signals only (SQLite class: free plan)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // owner creation per IP 5/min, sending per caller 120/min; registration: enroll per IP 5/min,
  // owner code lookups per owner 10/min, an enrolling agent's claim polls per code 60/min
  "ratelimits": [
    { "name": "OWNER_LIMIT", "namespace_id": "6002", "simple": { "limit": 5, "period": 60 } },
    { "name": "SEND_LIMIT", "namespace_id": "6003", "simple": { "limit": 120, "period": 60 } },
    { "name": "ENROLL_LIMIT", "namespace_id": "6004", "simple": { "limit": 5, "period": 60 } },
    { "name": "ENROLL_LOOKUP_LIMIT", "namespace_id": "6005", "simple": { "limit": 10, "period": 60 } },
    { "name": "ENROLL_POLL_LIMIT", "namespace_id": "6006", "simple": { "limit": 60, "period": 60 } },
  ],
  // hourly: drop expired envelopes (30 days) and registration codes
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "ENVELOPE_TTL_DAYS": "30" },
}
